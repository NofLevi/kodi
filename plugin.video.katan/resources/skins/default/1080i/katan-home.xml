<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">5000</defaultcontrol>
    <controls>

        <!-- backdrop: bound to window properties the Python side updates on
             focus changes, which is far cheaper than cross-container INFO
             lookups on a slow GPU -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <aspectratio>scale</aspectratio>
            <texture background="true" fallback="special://home/addons/plugin.video.katan/resources/media/fanart.jpg">$INFO[Window.Property(katan.hero.fanart)]</texture>
            <animation effect="fade" time="300">Visible</animation>
        </control>

        <!-- readability scrim: one flat texture, no gradients to composite -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://home/addons/plugin.video.katan/resources/media/scrim.png</texture>
        </control>

        <!-- hero -->
        <control type="group">
            <left>90</left>
            <top>96</top>
            <width>980</width>
            <height>350</height>
            <visible>!String.IsEmpty(Window.Property(katan.hero.title))</visible>

            <control type="label">
                <left>0</left>
                <top>0</top>
                <width>900</width>
                <height>70</height>
                <font>font30_title</font>
                <textcolor>white</textcolor>
                <shadowcolor>black</shadowcolor>
                <label>$INFO[Window.Property(katan.hero.title)]</label>
            </control>

            <control type="label">
                <left>0</left>
                <top>72</top>
                <width>900</width>
                <height>34</height>
                <font>font13</font>
                <textcolor>grey</textcolor>
                <label>$INFO[Window.Property(katan.hero.meta)]</label>
            </control>

            <control type="textbox">
                <left>0</left>
                <top>118</top>
                <width>900</width>
                <height>160</height>
                <font>font13</font>
                <textcolor>white</textcolor>
                <label>$INFO[Window.Property(katan.hero.plot)]</label>
            </control>
        </control>

        <!-- top bar -->
