<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <!-- The close button, which is the only focusable control here. Naming
         anything else would be naming something that may not be visible yet,
         which is what made two other windows log "asked to focus, but it
         can't" on every open. -->
    <defaultcontrol always="true">9110</defaultcontrol>
    <controls>

        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://home/addons/plugin.video.katan/resources/media/scrim.png</texture>
        </control>

        <control type="group">
            <left>360</left>
            <top>140</top>
            <width>1200</width>
            <height>800</height>

            <control type="label">
                <left>0</left>
                <top>0</top>
                <width>1200</width>
                <height>60</height>
                <font>font30_title</font>
                <textcolor>white</textcolor>
                <shadowcolor>black</shadowcolor>
                <label>$INFO[Window.Property(katan.auth.title)]</label>
            </control>

            <!-- The code to scan. Drawn on a white plate because a QR code
                 needs its quiet zone to be light, and this window is not. -->
            <control type="image">
                <left>0</left>
                <top>90</top>
                <width>420</width>
                <height>420</height>
                <texture>special://home/addons/plugin.video.katan/resources/media/field.png</texture>
                <visible>!String.IsEmpty(Window.Property(katan.auth.image))</visible>
            </control>
            <control type="image">
                <left>10</left>
                <top>100</top>
                <width>400</width>
                <height>400</height>
                <aspectratio>keep</aspectratio>
                <texture>$INFO[Window.Property(katan.auth.image)]</texture>
                <visible>!String.IsEmpty(Window.Property(katan.auth.image))</visible>
            </control>

            <control type="group">
                <left>470</left>
                <top>90</top>
                <width>730</width>
                <height>420</height>

                <control type="textbox">
                    <left>0</left>
                    <top>0</top>
                    <width>730</width>
                    <height>150</height>
                    <font>font13</font>
                    <textcolor>white</textcolor>
                    <label>$INFO[Window.Property(katan.auth.message)]</label>
                </control>

                <control type="label">
                    <left>0</left>
                    <top>160</top>
                    <width>730</width>
                    <height>44</height>
                    <font>font16</font>
                    <textcolor>grey</textcolor>
                    <label>$INFO[Window.Property(katan.auth.url)]</label>
                </control>

                <!-- The code, as large as it will go. On a projector across a
                     room this is the thing that has to be readable. -->
                <control type="label">
                    <left>0</left>
                    <top>220</top>
                    <width>730</width>
                    <height>90</height>
                    <font>font30_title</font>
                    <textcolor>white</textcolor>
                    <shadowcolor>black</shadowcolor>
                    <label>$INFO[Window.Property(katan.auth.code)]</label>
                    <visible>!String.IsEmpty(Window.Property(katan.auth.code))</visible>
                </control>

                <control type="progress" id="9120">
                    <left>0</left>
                    <top>340</top>
                    <width>730</width>
                    <height>12</height>
                </control>
            </control>

            <control type="button" id="9110">
                <left>0</left>
                <top>560</top>
                <width>260</width>
                <height>56</height>
                <font>font13</font>
                <textcolor>white</textcolor>
                <focusedcolor>FF141414</focusedcolor>
                <align>center</align>
                <label>$ADDON[plugin.video.katan 32465]</label>
                <texturefocus border="2">special://home/addons/plugin.video.katan/resources/media/button-focus.png</texturefocus>
                <texturenofocus border="2">special://home/addons/plugin.video.katan/resources/media/button.png</texturenofocus>
                <onleft>9110</onleft>
                <onright>9110</onright>
                <onup>9110</onup>
                <ondown>9110</ondown>
            </control>
        </control>

    </controls>
</window>
