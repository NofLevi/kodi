<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">3100</defaultcontrol>
    <controls>

        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://home/addons/plugin.video.pinky/resources/media/scrim.png</texture>
        </control>

        <!-- what has been typed so far -->
        <control type="image">
            <left>90</left>
            <top>70</top>
            <width>1200</width>
            <height>64</height>
            <texture border="2">special://home/addons/plugin.video.pinky/resources/media/field.png</texture>
        </control>
        <!-- A real edit control rather than a label. When an edit control
             has focus Kodi delivers a physical keyboard's keys to it as text
             and skips the keymap, which is the only way this window can be
             typed into: Kodi 21's Action carries no character, and a letter
             pressed anywhere else runs whatever the keymap binds it to - one
             of them opens the PVR channel list. Phone remotes (Kore, Yatse)
             send text the same way, into a focused edit control. -->
        <control type="edit" id="3100">
            <left>106</left>
            <top>70</top>
            <width>1168</width>
            <height>64</height>
            <font>font16</font>
            <textcolor>white</textcolor>
            <focusedcolor>white</focusedcolor>
            <hinttext>$ADDON[plugin.video.pinky 32290]</hinttext>
            <texturefocus border="2">special://home/addons/plugin.video.pinky/resources/media/button-focus.png</texturefocus>
            <texturenofocus />
            <ondown>5100</ondown>
            <onright>3905</onright>
        </control>

        <!-- suggestions and results -->
        <control type="label">
            <left>90</left>
            <top>150</top>
            <width>1740</width>
            <height>40</height>
            <font>font13</font>
            <textcolor>grey</textcolor>
            <label>$INFO[Window.Property(pinky.search.status)]</label>
        </control>

        <control type="list" id="5100">
            <left>90</left>
            <top>200</top>
            <width>1740</width>
            <height>790</height>
            <onleft>5100</onleft>
            <onright>5100</onright>
            <orientation>vertical</orientation>
            <scrolltime tween="sine">180</scrolltime>
            <preloaditems>2</preloaditems>
            <itemlayout width="1740" height="112">
                <control type="image">
                    <left>4</left>
                    <top>4</top>
                    <width>72</width>
                    <height>104</height>
                    <aspectratio>scale</aspectratio>
                    <texture fallback="special://home/addons/plugin.video.pinky/resources/media/poster.png">$INFO[ListItem.Art(poster)]</texture>
                </control>
                <control type="label">
                    <left>96</left>
                    <top>20</top>
                    <width>1620</width>
                    <height>36</height>
                    <font>font14</font>
                    <textcolor>white</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>96</left>
                    <top>58</top>
                    <width>1620</width>
                    <height>30</height>
                    <font>font12</font>
                    <textcolor>grey</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </itemlayout>
            <focusedlayout width="1740" height="112">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>1740</width>
                    <height>112</height>
                    <texture border="3">special://home/addons/plugin.video.pinky/resources/media/row-focus.png</texture>
                    <visible>Control.HasFocus(5100)</visible>
                </control>
                <control type="image">
                    <left>4</left>
                    <top>4</top>
                    <width>72</width>
                    <height>104</height>
                    <aspectratio>scale</aspectratio>
                    <texture fallback="special://home/addons/plugin.video.pinky/resources/media/poster.png">$INFO[ListItem.Art(poster)]</texture>
                </control>
                <control type="label">
                    <left>96</left>
                    <top>20</top>
                    <width>1620</width>
                    <height>36</height>
                    <font>font14</font>
                    <textcolor>white</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>96</left>
                    <top>58</top>
                    <width>1620</width>
                    <height>30</height>
                    <font>font12</font>
                    <textcolor>grey</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </focusedlayout>
        </control>

        <!-- 300, not 196. "Speak from your phone" is four words and was
             drawn as "Speak from ...", which names neither what it does nor
             where. The row has the space: the key grid ends at 646. -->

        <control type="button" id="3905">
            <left>1302</left>
            <top>70</top>
            <width>250</width>
            <height>64</height>
            <onleft>3100</onleft>
            <onright>3904</onright>
            <ondown>5100</ondown>
            <onup>3100</onup>
            <font>font13</font>
            <textcolor>white</textcolor>
            <focusedcolor>FF141414</focusedcolor>
            <align>center</align>
            <label>$ADDON[plugin.video.pinky 32522]</label>
            <texturefocus border="2">special://home/addons/plugin.video.pinky/resources/media/button-focus.png</texturefocus>
            <texturenofocus border="2">special://home/addons/plugin.video.pinky/resources/media/button.png</texturenofocus>
        </control>
        <control type="button" id="3904">
            <left>1564</left>
            <top>70</top>
            <width>266</width>
            <height>64</height>
            <onleft>3905</onleft>
            <onright>3904</onright>
            <ondown>5100</ondown>
            <onup>3100</onup>
            <font>font13</font>
            <textcolor>white</textcolor>
            <focusedcolor>FF141414</focusedcolor>
            <align>center</align>
            <label>$ADDON[plugin.video.pinky 32295]</label>
            <texturefocus border="2">special://home/addons/plugin.video.pinky/resources/media/button-focus.png</texturefocus>
            <texturenofocus border="2">special://home/addons/plugin.video.pinky/resources/media/button.png</texturenofocus>
        </control>

    </controls>
</window>
