<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">9100</defaultcontrol>
    <controls>

        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <aspectratio>scale</aspectratio>
            <texture background="true" fallback="special://home/addons/plugin.video.pinky/resources/media/fanart.jpg">$INFO[Window.Property(pinky.detail.fanart)]</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://home/addons/plugin.video.pinky/resources/media/scrim.png</texture>
        </control>

        <control type="image">
            <left>90</left>
            <top>110</top>
            <width>300</width>
            <height>450</height>
            <aspectratio>scale</aspectratio>
            <texture fallback="special://home/addons/plugin.video.pinky/resources/media/poster.png">$INFO[Window.Property(pinky.detail.poster)]</texture>
        </control>

        <control type="label">
            <left>430</left>
            <top>104</top>
            <width>1400</width>
            <height>66</height>
            <font>font30_title</font>
            <textcolor>white</textcolor>
            <shadowcolor>black</shadowcolor>
            <label>$INFO[Window.Property(pinky.detail.title)]</label>
        </control>
        <control type="label">
            <left>430</left>
            <top>172</top>
            <width>1400</width>
            <height>36</height>
            <font>font13</font>
            <textcolor>grey</textcolor>
            <label>$INFO[Window.Property(pinky.detail.meta)]</label>
        </control>
        <control type="textbox">
            <left>430</left>
            <top>220</top>
            <width>1320</width>
            <height>210</height>
            <font>font13</font>
            <textcolor>white</textcolor>
            <label>$INFO[Window.Property(pinky.detail.plot)]</label>
            <autoscroll time="4000" delay="8000" repeat="10000">true</autoscroll>
        </control>
        <control type="label">
            <left>430</left>
            <top>440</top>
            <width>1320</width>
            <height>34</height>
            <font>font12</font>
            <textcolor>grey</textcolor>
            <label>$INFO[Window.Property(pinky.detail.cast)]</label>
        </control>

        <control type="grouplist" id="9099">
            <left>430</left>
            <top>492</top>
            <width>1400</width>
            <height>60</height>
            <orientation>horizontal</orientation>
            <itemgap>14</itemgap>
            <ondown>5300</ondown>
            <!-- 320 rather than 230: this used to say only "Play", and now
                 it names the episode it will act on, which "Choose a source"
                 did before it was removed. Auto width would size these to
                 their own labels and end this class of bug, but a rendering
                 change has to be checked in a real Kodi. -->
            <control type="button" id="9100">
                <width>320</width>
                <height>60</height>
                <font>font14</font>
                <textcolor>white</textcolor>
                <focusedcolor>FF141414</focusedcolor>
                <align>center</align>
                <!-- Names the episode it will act on, so the viewer can see
                     it rather than find out by pressing. Set by
                     _update_action_label on every move; never empty. -->
                <label>$INFO[Window.Property(pinky.detail.playlabel)]</label>
                <texturefocus border="2">special://home/addons/plugin.video.pinky/resources/media/button-focus.png</texturefocus>
                <texturenofocus border="2">special://home/addons/plugin.video.pinky/resources/media/button.png</texturenofocus>
            </control>
            <control type="button" id="9102">
                <width>230</width>
                <height>60</height>
                <font>font14</font>
                <textcolor>white</textcolor>
                <focusedcolor>FF141414</focusedcolor>
                <align>center</align>
                <label>$ADDON[plugin.video.pinky 32253]</label>
                <visible>!String.IsEmpty(Window.Property(pinky.detail.trailer))</visible>
                <texturefocus border="2">special://home/addons/plugin.video.pinky/resources/media/button-focus.png</texturefocus>
                <texturenofocus border="2">special://home/addons/plugin.video.pinky/resources/media/button.png</texturenofocus>
            </control>
            <!-- Widest on purpose. "Add to Trakt watchlist" is four words in
                 Hebrew and one Latin word, and at 270 it was clipped at both
                 ends: the label read as a fragment with no beginning. -->
            <control type="button" id="9103">
                <width>360</width>
                <height>60</height>
                <font>font14</font>
                <textcolor>white</textcolor>
                <focusedcolor>FF141414</focusedcolor>
                <align>center</align>
                <label>$ADDON[plugin.video.pinky 32251]</label>
                <texturefocus border="2">special://home/addons/plugin.video.pinky/resources/media/button-focus.png</texturefocus>
                <texturenofocus border="2">special://home/addons/plugin.video.pinky/resources/media/button.png</texturenofocus>
            </control>
        </control>

        <control type="label">
            <left>90</left>
            <top>592</top>
            <width>1740</width>
            <height>36</height>
            <font>font16</font>
            <textcolor>white</textcolor>
            <label>$INFO[Window.Property(pinky.detail.listheading)]</label>
            <visible>!String.IsEmpty(Window.Property(pinky.detail.listheading))</visible>
        </control>

        <control type="list" id="5300">
            <left>90</left>
            <top>636</top>
            <width>1740</width>
            <height>380</height>
            <onup>9100</onup>
            <!-- Sideways out of the list, and this is the whole reason the
                 buttons can act on the highlighted episode at all. Reaching
                 them with Up means pressing it once per row, and every one of
                 those presses walks the selection up with it - so by the time
                 a button has focus the list really is back on the first
                 episode. Either sideways key leaves in one press and the
                 cursor stays where the viewer left it - and on a vertical
                 list neither of them does anything else, so nothing is
                 taken away by using them. -->
            <onright>9101</onright>
            <onleft>9101</onleft>
            <orientation>vertical</orientation>
            <scrolltime tween="sine">180</scrolltime>
            <preloaditems>2</preloaditems>
            <visible>!String.IsEmpty(Window.Property(pinky.detail.listheading))</visible>
            <itemlayout width="1740" height="76">
                <control type="image">
                    <left>4</left>
                    <top>4</top>
                    <width>120</width>
                    <height>68</height>
                    <aspectratio>scale</aspectratio>
                    <texture fallback="special://home/addons/plugin.video.pinky/resources/media/poster.png">$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="label">
                    <left>142</left>
                    <top>8</top>
                    <width>1400</width>
                    <height>34</height>
                    <font>font13</font>
                    <textcolor>white</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>142</left>
                    <top>42</top>
                    <width>1400</width>
                    <height>28</height>
                    <font>font12</font>
                    <textcolor>grey</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
                <control type="image">
                    <left>1680</left>
                    <top>22</top>
                    <width>32</width>
                    <height>32</height>
                    <texture>special://home/addons/plugin.video.pinky/resources/media/watched.png</texture>
                    <visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
                </control>
            </itemlayout>
            <focusedlayout width="1740" height="76">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>1740</width>
                    <height>76</height>
                    <texture border="3">special://home/addons/plugin.video.pinky/resources/media/row-focus.png</texture>
                    <visible>Control.HasFocus(5300)</visible>
                </control>
                <control type="image">
                    <left>4</left>
                    <top>4</top>
                    <width>120</width>
                    <height>68</height>
                    <aspectratio>scale</aspectratio>
                    <texture fallback="special://home/addons/plugin.video.pinky/resources/media/poster.png">$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="label">
                    <left>142</left>
                    <top>8</top>
                    <width>1400</width>
                    <height>34</height>
                    <font>font13</font>
                    <textcolor>white</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>142</left>
                    <top>42</top>
                    <width>1400</width>
                    <height>28</height>
                    <font>font12</font>
                    <textcolor>grey</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
                <control type="image">
                    <left>1680</left>
                    <top>22</top>
                    <width>32</width>
                    <height>32</height>
                    <texture>special://home/addons/plugin.video.pinky/resources/media/watched.png</texture>
                    <visible>Integer.IsGreater(ListItem.PlayCount,0)</visible>
                </control>
            </focusedlayout>
        </control>

    </controls>
</window>
