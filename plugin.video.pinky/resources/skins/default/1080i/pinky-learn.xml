<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <!-- One label, and deliberately nothing else. The first version of this
         screen used Kodi's progress dialog, which carries a Cancel button -
         so the opening instruction, "press OK", pressed Cancel and closed
         the screen. A question has to survive its own answer, so there is
         nothing here to press. -->
    <controls>

        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://home/addons/plugin.video.pinky/resources/media/button.png</texture>
            <colordiffuse>E6000000</colordiffuse>
        </control>

        <control type="label" id="9310">
            <left>160</left>
            <top>420</top>
            <width>1600</width>
            <height>240</height>
            <font>font30</font>
            <textcolor>white</textcolor>
            <align>center</align>
            <aligny>center</aligny>
            <wrapmultiline>true</wrapmultiline>
            <label></label>
        </control>

    </controls>
</window>
